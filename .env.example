# TeddyPups U.A.E. Environment Configuration

# Server Port
PORT=3000

# Base URL
NEXT_PUBLIC_SITE_URL=https://puppy.instabizweb.com

# Database Configuration (MongoDB / SQLite fallback)
# Set MONGODB_URI to your MongoDB Atlas or local connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/teddypups?retryWrites=true&w=majority
# If left unset, it automatically defaults to local SQLite (./data/teddypups.db) for offline development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/teddypups?retryWrites=true&w=majority
MONGODB_DB=teddypups

# Database Path (for local SQLite fallback)
DATABASE_PATH=./data/teddypups.db

# Optional WhatsApp Contact Number
NEXT_PUBLIC_WHATSAPP_NUMBER=+971500000000
