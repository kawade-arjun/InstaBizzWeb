# TeddyPups U.A.E. Environment Configuration

# Server Port
PORT=3000

# Base URL
NEXT_PUBLIC_SITE_URL=https://puppy.instabizweb.com

# Database Configuration (PostgreSQL / SQLite fallback)
# Set DATABASE_URL to your PostgreSQL connection string (Neon, Supabase, Vercel, Railway, etc.)
# If left unset, it automatically defaults to local SQLite (./data/teddypups.db) for offline development
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Database Path (for local SQLite fallback)
DATABASE_PATH=./data/teddypups.db

# Optional WhatsApp Contact Number
NEXT_PUBLIC_WHATSAPP_NUMBER=+971500000000
